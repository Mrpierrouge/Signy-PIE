# Copy this file to `.env.local` (ignored by git) to change the backend URL.
# Default when not set: http://localhost:8000

# To test on a phone through an HTTPS tunnel, go through the Vite proxy (see vite.config.ts):
# VITE_API_URL=/api

# Fake /api/auth server to work on login / sign-up without the backend (see mock/authMock.ts).
# Needs VITE_API_URL=/api. Remove once the backend implements /auth.
# VITE_MOCK_AUTH=true
